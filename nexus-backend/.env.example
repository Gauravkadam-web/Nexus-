# ==============================================================================
# Nexus Backend — Environment Variables Configuration (.env)
# Copy this file to '.env' in nexus-backend/ and configure your local values.
# ==============================================================================

# Active Spring Profile (local | prod)
SPRING_PROFILES_ACTIVE=local

# ==============================================================================
# 1. Database Connection (Local PostgreSQL or Supabase)
# ==============================================================================
# For Local Postgres:
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/nexus_dev
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your_local_postgres_password

# For Supabase Cloud Postgres (uncomment when using Supabase):
# SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_DB_USERNAME=postgres
# SUPABASE_DB_PASSWORD=your_supabase_password

# ==============================================================================
# 2. Supabase Storage (Case attachments & evidence)
# ==============================================================================
SUPABASE_STORAGE_URL=https://placeholder-project.supabase.co/storage/v1
SUPABASE_STORAGE_KEY=placeholder_service_role_key
SUPABASE_STORAGE_BUCKET=nexus-attachments

# ==============================================================================
# 3. JWT Authentication Security
# ==============================================================================
JWT_SECRET=nexus_super_secret_jwt_key_at_least_32_characters_long_for_development_security
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ==============================================================================
# 4. AI Provider (mock | openai | anthropic | gemini)
# Use 'mock' for local development with zero API costs
# ==============================================================================
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# 5. Email Provider (mock | brevo | smtp)
# ==============================================================================
EMAIL_PROVIDER=mock
BREVO_API_KEY=
BREVO_SENDER_EMAIL=support@nexus.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ==============================================================================
# 6. Monitoring & CORS
# ==============================================================================
SENTRY_DSN=
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app
