# Nexus Backend Environment Variables Template
SPRING_PROFILES_ACTIVE=local

# Supabase PostgreSQL Connection
SUPABASE_DB_URL=jdbc:postgresql://<db-host>:5432/<db-name>?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Supabase Storage
SUPABASE_STORAGE_URL=https://<project-id>.supabase.co/storage/v1
SUPABASE_STORAGE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=nexus-attachments

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Provider (mock | openai | anthropic | gemini)
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Email Provider (mock | brevo | smtp)
EMAIL_PROVIDER=mock
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Monitoring & Tracking
SENTRY_DSN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app
