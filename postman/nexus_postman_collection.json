                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VPN Gateway Timeout across Frankfurt Region\",\n  \"description\": \"Engineers are experiencing 504 Gateway Timeouts when connecting to the EU-Central-1 VPN tunnel.\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"priority\": \"HIGH\",\n  \"severity\": \"HIGH\",\n  \"location\": \"Frankfurt Data Center\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cases"]
            }
          }
        },
