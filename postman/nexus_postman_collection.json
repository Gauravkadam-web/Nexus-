        {
          "name": "US-1: Create Case",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json().data;",
                  "    pm.environment.set('caseId', data.id);",
                  "    console.log('Created Case ID: ' + data.id);",
